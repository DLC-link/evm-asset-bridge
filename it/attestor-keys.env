# =============================================================================
# evm-asset-bridge IT stack — attestor key handoff
# =============================================================================
#
# PUBLIC, WELL-KNOWN ANVIL/FOUNDRY TEST KEYS. These are derived from the
# standard test mnemonic that ships with every Foundry/Hardhat install:
#
#     test test test test test test test test test test test junk
#
# at derivation path m/44'/60'/0'/0/{index}, e.g.:
#     cast wallet derive-private-key "test test test test ... junk" <index>
#
# Anyone, anywhere, can derive these same keys from that same public phrase.
# They are checked into this repo on purpose, for the local Docker IT stack
# ONLY. NEVER send real funds to any address in this file, on any network
# that is not this repo's disposable local anvil instance.
#
# Index assignment (see script/DeployIT.s.sol for the full table and the
# resulting fixed contract addresses):
#   0 = deployer / ProxyAdmin owner   1 = defaultAdmin   2 = bridgeAdmin
#   3,4,5 = attestors (threshold 2 of 3)   6 = test user
#
# -----------------------------------------------------------------------------
# Consuming this file in a dlc-attestor node
# -----------------------------------------------------------------------------
# The dlc-attestor Docker setup (see dlc-attestor-stack/it/docker-compose.yml
# and dlc-attestor-stack/it/attestor-config.docker.toml) configures each
# attestor's EVM signing key via ONE environment variable per container,
# consumed by the attestor's chain config as:
#
#     [[chains]]
#     network = "<chain-name>"
#     chain_type = "evm"
#     endpoint = "http://anvil:8545"
#     private_key = "${EVM_PRIVATE_KEY}"
#
# Because every attestor container reads the SAME variable name
# (EVM_PRIVATE_KEY) from its OWN environment, the three keys below are
# listed per-attestor (ATTESTOR_N_EVM_PRIVATE_KEY) so a compose file can
# fan them out — e.g. for the dlc-link-attestor-1 service:
#
#     environment:
#       EVM_PRIVATE_KEY: ${ATTESTOR_1_EVM_PRIVATE_KEY}
#
# and likewise ATTESTOR_2_EVM_PRIVATE_KEY -> dlc-link-attestor-2's
# EVM_PRIVATE_KEY, ATTESTOR_3_EVM_PRIVATE_KEY -> dlc-link-attestor-3's.
# =============================================================================

# --- Attestor #1 (mnemonic index 3) -----------------------------------------
ATTESTOR_1_ADDRESS=0x90F79bf6EB2c4f870365E785982E1f101E93b906
ATTESTOR_1_EVM_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# --- Attestor #2 (mnemonic index 4) -----------------------------------------
ATTESTOR_2_ADDRESS=0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65
ATTESTOR_2_EVM_PRIVATE_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a

# --- Attestor #3 (mnemonic index 5) -----------------------------------------
ATTESTOR_3_ADDRESS=0x9965507D1a55bcC2695C58ba16FB37d819B0A4dc
ATTESTOR_3_EVM_PRIVATE_KEY=0x8b3a350cf5c34c9194ca85829a2df0ec3153be0318b5e2d3348e872092edffba

# -----------------------------------------------------------------------------
# Other named IT accounts, for reference (not attestor keys, but derived from
