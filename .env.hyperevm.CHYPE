# Deploy config for the production CHYPE bridge on HyperEVM mainnet (chain id 999).
# The file name schema is .env.{network}.{deployment}.
# This file holds no secret and no secret reference. Every value here
# lands on-chain at deploy time.
#
# The deployer must turn on HyperEVM big blocks first. README.md,
# "Deploying on HyperEVM", gives the steps.
#
# Load for one shell, then run the deploy:
#   set -a; source .env.hyperevm.CHYPE; set +a
#   make deploy DEPLOYMENT=CHYPE RPC_URL=<url> SIGNER="--account <name> --sender <deployer> --disable-block-gas-limit --timeout 300"

# ---- Deploy values ---------------------------------------------------------
# The values below feed `initialize` on a fresh deploy.

# Native HYPE is the bridged asset.
ASSET=0x0000000000000000000000000000000000000000

# Canton expresses 10 decimal places (CIP-56).
TARGET_DECIMALS=10

# The admin authorities match BETH mainnet. GOVERNANCE.md gives the rules
# for each address. The Multi-org Safe holds the default admin role, and it
# proposes and executes on the upgrade timelock.
DEFAULT_ADMIN=0xb28270e6D63222D14453e1a76322C8313d5A1D63
PROXY_OWNER=0xb28270e6D63222D14453e1a76322C8313d5A1D63

# The BitSafe Safe holds the bridge admin role: pause, limits, rescue.
BRIDGE_ADMIN=0x6694Ad29359d78cf9eB4929470029e75d3b94c8A

# Default-admin transfer delay, in seconds.
ADMIN_DELAY=600

# Upgrade timelock delay, in seconds. The timelock owns the ProxyAdmin, and
# PROXY_OWNER drives the timelock.
TIMELOCK_DELAY=600

# Comma-separated attestor addresses and the signature threshold.
# The bridge uses the two live BETH mainnet attestors, two signatures per
# withdrawal.
ATTESTORS=0xE74c19c0A4B54E37dd5E8B1c0E2f5f21494468f9,0xa92E4313894FbE76CED75fEb5e6Bd059849e18C5
THRESHOLD=2

# Deposit and withdraw limits, in wei: 0.25 HYPE minimum and 2,500 HYPE
# maximum. These match the USD value of the BETH mainnet limits at deploy
# time. The bridge admin changes them with SetDepositLimits and
# SetWithdrawLimits.
DEPOSIT_MIN=250000000000000000
DEPOSIT_MAX=2500000000000000000000
WITHDRAW_MIN=250000000000000000
WITHDRAW_MAX=2500000000000000000000

# ---- Management values -----------------------------------------------------
# A set SAFE selects Safe mode. The action script then writes an envelope,
# and it sends nothing. Unset SAFE for a direct broadcast from your own wallet.
# RPC_URL stays out of this file on purpose. A keyed endpoint URL is a secret.
DEPLOYMENT=CHYPE
# Bridge admin actions go through the BitSafe Safe. A default-admin action
# needs the Multi-org Safe instead: pass SAFE=$DEFAULT_ADMIN on that make line.
SAFE=0x6694Ad29359d78cf9eB4929470029e75d3b94c8A
