# Deploy config for the BETH_DEVNET bridge on Sepolia (chain id 11155111).
# This instance serves the attestors that run against Canton devnet. The
# Canton-testnet instance has its own file, .env.sepolia.BETH_TESTNET.
# The file name schema is .env.{network}.{deployment}.
# This file holds no secret and no secret reference. Every value here
# lands on-chain at deploy time. The deployer key lives in the Foundry
# keystore (`cast wallet import deployer`). The explorer API key lives
# in the team password manager; the verify command reads it at run time.
#
# Load for one shell, then run the deploy:
#   set -a; source .env.sepolia.BETH_DEVNET; set +a
#   make deploy DEPLOYMENT=BETH_DEVNET RPC_URL=<url> SIGNER="--account deployer --sender <deployer>"

# ---- Deploy values ---------------------------------------------------------
# The values below feed `initialize` on a fresh deploy. They do not report the
# live bridge. Read the state block after them for the live bridge.

# ETH is the bridged asset.
ASSET=0x0000000000000000000000000000000000000000

# Canton expresses 10 decimal places (CIP-56).
TARGET_DECIMALS=10

# The Safe holds the admin authorities on the live bridge. A fresh deploy
# therefore gives the Safe the same three roles.
DEFAULT_ADMIN=0x995236279E21ab9c65658bf4B32AC3D6e6880342
BRIDGE_ADMIN=0x995236279E21ab9c65658bf4B32AC3D6e6880342
# On mainnet, PROXY_OWNER is the multi-organisation Safe, the same address
# as DEFAULT_ADMIN. GOVERNANCE.md gives the reason: no single organisation
# may change the bridge code on its own.
PROXY_OWNER=0x995236279E21ab9c65658bf4B32AC3D6e6880342

# Default-admin transfer delay, in seconds. One minute on a testnet.
ADMIN_DELAY=60

# Upgrade timelock delay, in seconds. The timelock owns the ProxyAdmin, and
# PROXY_OWNER drives the timelock. One minute on a testnet.
TIMELOCK_DELAY=60

# Comma-separated attestor addresses and the signature threshold.
ATTESTORS=0x3355977947F84C2b1CAE7D2903a72958aEE185e2,0xA2c975F49f578AC3E384Ad21E2126968b82037f5,0x3fF31dCd8ca84b594e355CfDf913738bFc192a5c
THRESHOLD=2

# The smallest deposit is one target-decimal unit: 1e8 wei.
DEPOSIT_MIN=100000000
# type(uint256).max is the documented "no maximum" sentinel.
DEPOSIT_MAX=115792089237316195423570985008687907853269984665640564039457584007913129639935
WITHDRAW_MIN=0
WITHDRAW_MAX=115792089237316195423570985008687907853269984665640564039457584007913129639935

# ---- Management values -----------------------------------------------------
# The management targets read SAFE. A set SAFE selects Safe mode. The action
# script then writes an envelope, and it sends nothing. Unset SAFE for a
# direct broadcast from your own wallet.
#
# RPC_URL stays out of this file on purpose. A keyed endpoint URL is a secret.
# Pass it on the command line, such as
# `make manage-status DEPLOYMENT=BETH_DEVNET RPC_URL=<url>`.

# DEPLOYMENT names this instance of BitSafeEvmAssetBridge. The management
# targets need it, and they set no default. The management scripts live under
# the contract, so the name must come from here or from the command line.
DEPLOYMENT=BETH_DEVNET
SAFE=0x995236279E21ab9c65658bf4B32AC3D6e6880342
