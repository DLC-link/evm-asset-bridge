# Deploy config for the production BETH bridge on Ethereum mainnet (chain id 1).
# The file name schema is .env.{network}.{deployment}.
# This file holds no secret and no secret reference. Every deploy value
# here lands on-chain at deploy time. The file holds the inputs for the next
# deploy and the management settings. It makes no claim about the chain.
#
# Load for one shell, then run the deploy:
#   set -a; source .env.mainnet.BETH; set +a
#   make deploy DEPLOYMENT=BETH RPC_URL=<url> SIGNER="--account <name> --sender <deployer>"

# ---- Deploy values ---------------------------------------------------------
# The values below feed `initialize` on a fresh deploy.

# ETH is the bridged asset.
ASSET=0x0000000000000000000000000000000000000000

# Canton expresses 10 decimal places (CIP-56). The deposit unit is 1e8 wei.
TARGET_DECIMALS=10

# A deploy from this file gives the default admin role to the Multi-org Safe.
# The deploy also makes the same Safe the proposer and executor of the upgrade
# timelock. GOVERNANCE.md gives the reason: no single organisation may change
# the attestor set or the bridge code on its own.
DEFAULT_ADMIN=0xb28270e6D63222D14453e1a76322C8313d5A1D63
PROXY_OWNER=0xb28270e6D63222D14453e1a76322C8313d5A1D63

# A deploy from this file gives the bridge admin role to the BitSafe Safe:
# pause, limits, rescue.
BRIDGE_ADMIN=0x6694Ad29359d78cf9eB4929470029e75d3b94c8A

# Default-admin transfer delay, in seconds.
ADMIN_DELAY=600

# Upgrade timelock delay, in seconds. A deploy builds a timelock that owns the
# ProxyAdmin. PROXY_OWNER drives that timelock. A change to the delay needs one
# scheduled timelock action, because the timelock administers itself.
TIMELOCK_DELAY=600

# Comma-separated attestor addresses and the signature threshold. Three
# operator attestors, two signatures per withdrawal.
ATTESTORS=0xd889B7F827dc65877452cC82ce3Bd01870392B4A,0xE74c19c0A4B54E37dd5E8B1c0E2f5f21494468f9,0xa92E4313894FbE76CED75fEb5e6Bd059849e18C5
THRESHOLD=2

# Deposit and withdrawal limits, in wei: 0.01 ETH minimum and 100 ETH
# maximum. The bridge admin changes them with SetDepositLimits and
# SetWithdrawLimits.
DEPOSIT_MIN=10000000000000000
DEPOSIT_MAX=100000000000000000000
WITHDRAW_MIN=10000000000000000
WITHDRAW_MAX=100000000000000000000

# ---- Management values -----------------------------------------------------
# The management targets read SAFE. A set SAFE selects Safe mode. The action
# script then writes an envelope, and it sends nothing. Unset SAFE for a
# direct broadcast from your own wallet.
#
# RPC_URL stays out of this file on purpose. A keyed endpoint URL is a secret.
# Pass it on the command line, such as
# `make manage-status DEPLOYMENT=BETH RPC_URL=<url>`.

# DEPLOYMENT names this instance of BitSafeEvmAssetBridge. The management
# targets need it, and they set no default.
DEPLOYMENT=BETH
# Bridge admin actions go through the BitSafe Safe. A default-admin action,
# such as a role grant or a threshold change, needs the Multi-org Safe
# instead: pass SAFE=$DEFAULT_ADMIN on that make line.
SAFE=0x6694Ad29359d78cf9eB4929470029e75d3b94c8A
