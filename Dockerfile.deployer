# Dockerfile.deployer
#
# One-shot Foundry deployer for the evm-asset-bridge IT stack: builds the
# contracts and runs script/DeployIT.s.sol against the `anvil` service over
# the docker-compose network, then exits. docker-compose.it.yml gates this
# service's start on anvil's healthcheck so it never races the chain.
#
# Build context is the repo root (see docker-compose.it.yml); only the
# inputs forge needs to build and run the IT script are copied in, so a
# change to test/ or docs/ does not invalidate this image's cache.
FROM ghcr.io/foundry-rs/foundry:latest

WORKDIR /app

COPY foundry.toml remappings.txt ./
COPY lib ./lib
COPY src ./src
COPY script ./script

# Clear the base image's entrypoint so CMD runs directly and unambiguously.
ENTRYPOINT []

# No --private-key flag: script/DeployIT.s.sol calls
# vm.startBroadcast(DEPLOYER_PK) itself with the hardcoded deployer key
# (mnemonic index 0), so forge already knows who is signing.
CMD ["sh", "-c", "forge build && forge script script/DeployIT.s.sol --rpc-url http://anvil:8545 --broadcast -vvvv"]
