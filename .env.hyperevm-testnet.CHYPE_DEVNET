# Deploy config for the CHYPE_DEVNET bridge on HyperEVM testnet (chain id 998).
# This instance serves the attestors that run against Canton devnet.
# The file name schema is .env.{network}.{deployment}.
# Set every REPLACE_ME before a deploy. Foundry refuses to deploy with one.
# This file holds no secret and no secret reference. Every value here
# lands on-chain at deploy time.
#
# The deployer must turn on HyperEVM big blocks first. README.md,
# "Deploying on HyperEVM", gives the steps.
#
# Load for one shell, then run the deploy:
#   set -a; source .env.hyperevm-testnet.CHYPE_DEVNET; set +a
#   make deploy DEPLOYMENT=CHYPE_DEVNET RPC_URL=<url> SIGNER="--account <name> --sender <deployer> --disable-block-gas-limit --timeout 300"

# ---- Deploy values ---------------------------------------------------------
# The values below feed `initialize` on a fresh deploy.

# Native HYPE is the bridged asset.
ASSET=0x0000000000000000000000000000000000000000

# Canton expresses 10 decimal places (CIP-56).
TARGET_DECIMALS=10

# The admin authorities. GOVERNANCE.md gives the rules for each address.
# Chain 998 has no Safe service, so the deployer EOA holds every role.
DEFAULT_ADMIN=0x7038f8a64cE8F879705A48e962B55d56aEcd60D8
BRIDGE_ADMIN=0x7038f8a64cE8F879705A48e962B55d56aEcd60D8
PROXY_OWNER=0x7038f8a64cE8F879705A48e962B55d56aEcd60D8

# Default-admin transfer delay, in seconds.
ADMIN_DELAY=60

# Upgrade timelock delay, in seconds. The timelock owns the ProxyAdmin, and
# PROXY_OWNER drives the timelock.
TIMELOCK_DELAY=60

# Comma-separated attestor addresses and the signature threshold.
ATTESTORS=0x3355977947F84C2b1CAE7D2903a72958aEE185e2,0xA2c975F49f578AC3E384Ad21E2126968b82037f5,0x3fF31dCd8ca84b594e355CfDf913738bFc192a5c
THRESHOLD=2

# Deposit and withdraw limits, in wei. type(uint256).max is the documented
# "no maximum" sentinel.
DEPOSIT_MIN=100000000
DEPOSIT_MAX=115792089237316195423570985008687907853269984665640564039457584007913129639935
WITHDRAW_MIN=0
WITHDRAW_MAX=115792089237316195423570985008687907853269984665640564039457584007913129639935

# ---- Management values -----------------------------------------------------
# A set SAFE selects Safe mode. The action script then writes an envelope,
# and it sends nothing. Unset SAFE for a direct broadcast from your own wallet.
# RPC_URL stays out of this file on purpose. A keyed endpoint URL is a secret.
DEPLOYMENT=CHYPE_DEVNET
# SAFE stays empty, so every script broadcasts from the deployer EOA.
SAFE=
