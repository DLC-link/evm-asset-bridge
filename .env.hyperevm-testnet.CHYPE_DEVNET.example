# Deploy config for the CHYPE_DEVNET bridge on HyperEVM testnet (chain id 998).
# This instance serves the attestors that run against Canton devnet.
# The file name schema is .env.{network}.{deployment}. The .example suffix
# marks a file whose values are not set yet. Copy it to
# .env.hyperevm-testnet.CHYPE_DEVNET and set every REPLACE_ME before a deploy.
# This file holds no secret and no secret reference. Every value here
# lands on-chain at deploy time.
#
# Load for one shell, then run the deploy:
#   set -a; source .env.hyperevm-testnet.CHYPE_DEVNET; set +a
#   make deploy DEPLOYMENT=CHYPE_DEVNET RPC_URL=<url> SIGNER="--account <name> --sender <deployer>"

# ---- Deploy values ---------------------------------------------------------
# The values below feed `initialize` on a fresh deploy.

# Native HYPE is the bridged asset.
ASSET=0x0000000000000000000000000000000000000000

# Canton expresses 10 decimal places (CIP-56).
TARGET_DECIMALS=10

# The admin authorities. GOVERNANCE.md gives the rules for each address.
DEFAULT_ADMIN=REPLACE_ME
BRIDGE_ADMIN=REPLACE_ME
PROXY_OWNER=REPLACE_ME

# Default-admin transfer delay, in seconds.
ADMIN_DELAY=REPLACE_ME

# Upgrade timelock delay, in seconds. The timelock owns the ProxyAdmin, and
# PROXY_OWNER drives the timelock.
TIMELOCK_DELAY=REPLACE_ME

# Comma-separated attestor addresses and the signature threshold.
ATTESTORS=REPLACE_ME
THRESHOLD=REPLACE_ME

# Deposit and withdraw limits, in wei. type(uint256).max is the documented
# "no maximum" sentinel.
DEPOSIT_MIN=REPLACE_ME
DEPOSIT_MAX=REPLACE_ME
WITHDRAW_MIN=REPLACE_ME
WITHDRAW_MAX=REPLACE_ME

# ---- Management values -----------------------------------------------------
# A set SAFE selects Safe mode. The action script then writes an envelope,
# and it sends nothing. Unset SAFE for a direct broadcast from your own wallet.
# RPC_URL stays out of this file on purpose. A keyed endpoint URL is a secret.
DEPLOYMENT=CHYPE_DEVNET
SAFE=REPLACE_ME
