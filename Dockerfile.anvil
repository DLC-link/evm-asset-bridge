# Dockerfile.anvil
#
# Local anvil (Foundry) chain for the evm-asset-bridge Docker-based
# integration-test (IT) stack. See docker-compose.it.yml for orchestration
# and script/DeployIT.s.sol / it/attestor-keys.env for the account table
# this chain's default accounts are expected to match.
#
# No --mnemonic flag is passed: anvil's own default account derivation
# already uses the standard, well-known Foundry/Hardhat test mnemonic
#
#     test test test test test test test test test test test junk
#
# at m/44'/60'/0'/0/{index} -- byte-for-byte the same 10 deterministic
# accounts `--mnemonic "test test ... junk"` would produce. Relying on the
# built-in default keeps this file simple without changing the guarantee:
# same chain id, same accounts, same addresses, every run.
#
# THESE ARE PUBLIC, WELL-KNOWN TEST KEYS (see it/attestor-keys.env).
# NEVER send real funds to any address this chain funds.
FROM ghcr.io/foundry-rs/foundry:latest

EXPOSE 8545

# Clear the base image's entrypoint so CMD runs directly and unambiguously.
ENTRYPOINT []

# --block-time 1: 1-second blocks so confirmation-count waits in tests and
#                 in the deployer's healthcheck-gated startup behave like a
#                 real chain instead of instant-mine.
# --host 0.0.0.0: bind on all interfaces so the port publishes to the host
#                 and is reachable from sibling containers by service name.
CMD ["anvil", "--block-time", "1", "--host", "0.0.0.0"]
