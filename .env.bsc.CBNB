# CBNB locks native BNB on BSC mainnet (chain ID 56).
# This file contains public deployment settings only.
# RPC credentials and signer credentials belong outside this file.

ASSET=0x0000000000000000000000000000000000000000
TARGET_DECIMALS=10
DEPLOYMENT=CBNB

# The multi-organisation Safe controls roles and the upgrade timelock.
# Both Safes temporarily use the operator-approved 1-of-3 threshold.
DEFAULT_ADMIN=0xb28270e6D63222D14453e1a76322C8313d5A1D63
PROXY_OWNER=0xb28270e6D63222D14453e1a76322C8313d5A1D63

# The BitSafe Safe controls pauses, limits, and rescue operations.
BRIDGE_ADMIN=0x6694Ad29359d78cf9eB4929470029e75d3b94c8A

# Both delays are 48 hours, expressed in seconds.
ADMIN_DELAY=172800
TIMELOCK_DELAY=172800

# Both CHYPE attestors must sign each withdrawal.
ATTESTORS=0xE74c19c0A4B54E37dd5E8B1c0E2f5f21494468f9,0xa92E4313894FbE76CED75fEb5e6Bd059849e18C5
THRESHOLD=2

# Each deposit and withdrawal allows 0.03–300 BNB, expressed in wei.
DEPOSIT_MIN=30000000000000000
DEPOSIT_MAX=300000000000000000000
WITHDRAW_MIN=30000000000000000
WITHDRAW_MAX=300000000000000000000
