#!/usr/bin/env bash
#
# A fake curl for the verify tests. It never reaches the network.
#
# script/verify.sh passes every request on stdin, because it always calls curl
# with `-K -`. This stub reads that request and prints a canned reply. The test
# picks the reply by writing the three files that FAKE_CURL_DIR holds.
#
# The stub also appends each request to FAKE_CURL_LOG, so a test can assert what
# verify.sh built, including the fields the dry-run path never prints.
REQUEST=$(cat)

if [ -n "${FAKE_CURL_LOG:-}" ]; then
  printf '%s\n--\n' "$REQUEST" >>"$FAKE_CURL_LOG"

  # propose.sh sends its JSON body by file reference, not inline. A local
  # `ps` therefore cannot show it. This resolves that one reference. A test
  # can then assert the real wire bytes curl would read from disk.
  DATA_LINE=$(printf '%s\n' "$REQUEST" | grep '^data-binary = "@' || true)
  if [ -n "$DATA_LINE" ]; then
    REF="${DATA_LINE#data-binary = \"@}"
    REF="${REF%\"}"
    [ -f "$REF" ] && cat "$REF" >>"$FAKE_CURL_LOG"
  fi
fi

DIR="${FAKE_CURL_DIR:-.}"
case "$REQUEST" in
  *multisig-transactions*) BODY="$DIR/post.txt" ;;
  *checkverifystatus*) BODY="$DIR/poll.txt" ;;
  *verifysourcecode*) BODY="$DIR/submit.txt" ;;
  *) BODY="$DIR/getabi.txt" ;;
esac

if [ ! -f "$BODY" ]; then
  echo "fake curl: the test wrote no $BODY" >&2
  exit 7
fi
cat "$BODY"
